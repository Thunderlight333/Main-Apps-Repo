{"name":"Morph: Convert, Compress, Edit","short_name":"Morph","description":"Convert, compress and edit videos, photos, audio and PDFs. Works offline.","start_url":"./","display":"standalone","background_color":"#0b0d17","theme_color":"#0b0d17","lang":"en","scope":"./","display_override":["window-controls-overlay","standalone"],"orientation":"any","icons":[{"src":"icons/icon-192.png","sizes":"192x192","type":"image/png"},{"src":"icons/icon-512.png","sizes":"512x512","type":"image/png"},{"src":"icons/icon-maskable-512.png","sizes":"512x512","type":"image/png","purpose":"maskable"},{"src":"icons/icon.svg","sizes":"any","type":"image/svg+xml"}],"share_target":{"action":"./share-target","method":"POST","enctype":"multipart/form-data","params":{"title":"title","text":"text","url":"url","files":[{"name":"files","accept":["*/*"]}]}},"file_handlers":[{"action":"./","accept":{"video/*":[".mp4",".mov",".mkv",".webm",".avi",".m4v"],"image/*":[".jpg",".jpeg",".png",".webp",".heic",".avif",".gif",".bmp"],"audio/*":[".mp3",".wav",".m4a",".flac",".ogg",".aac"],"application/pdf":[".pdf"]}}],"launch_handler":{"client_mode":"focus-existing"}}
